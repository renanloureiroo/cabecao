{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!website/.astro",
      "!**/*.md",
      "!**/CHANGELOG.md",
      "!pnpm-lock.yaml",
      "!docs",
      "!spikes",
      "!fixtures",
      "!templates"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
