{
  "name": "cabecao-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:skills": "node scripts/build-skills.mjs",
    "build:plugin": "pnpm --filter cabecao build && node scripts/build-plugin.mjs",
    "build:mcpb": "pnpm --filter cabecao build && node scripts/build-mcpb.mjs",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "docs:dev": "pnpm --filter cabecao-docs docs:dev",
    "docs:build": "pnpm --filter cabecao-docs docs:build",
    "docs:serve": "pnpm --filter cabecao-docs docs:serve",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm build:plugin"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.19.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
